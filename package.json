{
  "name": "Portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "doppler run --config dev -- next dev",
    "build": "next build",
    "start:dev": "doppler run --config dev -- cross-env-shell \"next start -p %PORTFOLIO_PORT%\"",
    "start:prod": "doppler run --config prod -- cross-env-shell \"next start -p %PORTFOLIO_PORT%\"",
    "lint": "next lint",
    "postbuild": "next-sitemap",
    "vercel-build": "npm install --legacy-peer-deps && next build",
    "all": "next dev -H 0.0.0.0" 
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.21",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.541.0",
    "next": "16.0.10",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "^4.1.17",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.10"
  }
}